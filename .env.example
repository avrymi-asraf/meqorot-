# ==============================================================================
# Agent Data Sources Configuration Template (.env.example)
# Copy this file to .env and supply your credentials:
#   cp .env.example .env
# Note: OpenLibrary, HebrewBooks, Sefaria, Local Books FTS5, Arctic Shift,
# Rotter RSS, Discourse, Google News RSS, Israeli News RSS, Telegram Web, and
# GDELT all work out-of-the-box with ZERO API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Books & Local Book Library (R1)
# ------------------------------------------------------------------------------

# Local Books SQLite FTS5 Index Path
LOCAL_BOOKS_DB_PATH=/home/avreymi/teamwork_projects/agent_data_sources/.local_books_index.db

# Google Books API Key (Free tier: 1,000 queries/day)
# Obtain at: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# Semantic Scholar API Key (S2AG - boosts rate limit to 10 req/sec)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# National Library of Israel (NLI) Developer Key
NLI_API_KEY=your_nli_developer_key_here

# Project Ben-Yehuda Personal API Key
BENYEHUDA_API_KEY=your_benyehuda_api_key_here


# ------------------------------------------------------------------------------
# 2. Social Networks & Personal Accounts (R2)
# ------------------------------------------------------------------------------

# Personal X.com (Twitter) Session Cookies (for reading your Bookmarks & Home Timeline)
# Extract from browser DevTools (F12 -> Application -> Cookies -> https://x.com)
X_AUTH_TOKEN=your_x_auth_token_cookie_here
X_CT0=your_x_ct0_csrf_cookie_here

# Personal Instagram Session Cookie (for reading your Saved posts & followed profiles)
# Extract from browser DevTools (F12 -> Application -> Cookies -> https://www.instagram.com)
IG_SESSIONID=your_instagram_sessionid_cookie_here

# SocialData.tools API Key (X.com search at $0.20 per 1,000 tweets, supports lang:he)
SOCIALDATA_API_KEY=your_socialdata_api_key_here

# Exa.ai Neural Search API Key (semantic search over x.com, instagram.com, facebook.com)
EXA_API_KEY=your_exa_api_key_here

# Apify API Token (Apify Instagram & Facebook Posts/Pages scrapers)
APIFY_API_TOKEN=your_apify_api_token_here


# ------------------------------------------------------------------------------
# 3. Discussion Forums & SERP Dorking (R3)
# ------------------------------------------------------------------------------

# Google Programmable Search Engine (Custom Search JSON API - 100 free queries/day)
GOOGLE_PSE_KEY=your_google_pse_api_key_here
GOOGLE_PSE_CX=your_programmable_search_engine_id_here

# SerpApi API Key (Alternative SERP provider for site:fxp.co.il / site:quora.com)
SERPAPI_API_KEY=your_serpapi_api_key_here

# StackExchange API Key (Boosts quota from 300/day to 10,000/day)
STACKEXCHANGE_API_KEY=your_stackexchange_app_key_here
